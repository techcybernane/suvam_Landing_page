# Origin of the Express API (server/). Next proxies /api and /uploads to it via
# next.config.js, which keeps the httpOnly auth cookie same-origin in the
# browser, and Server Components fetch it directly (lib/server-api.js).
#
# Local:      http://localhost:4000
# Production: the HTTPS URL of the deployed API, with no trailing slash
BACKEND_ORIGIN=http://localhost:4000
