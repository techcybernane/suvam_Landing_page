# Server
PORT=4000

# Comma-separated list of browser origins allowed to call this API directly.
# In production this is your Vercel domain(s). Note the browser normally reaches
# the API through the Next proxy on the same origin, so this is a safety net.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Where content, uploads and the JSON store live. MUST be a persistent volume in
# production — the app writes here on every admin save, lead and upload.
# DATA_DIR=/var/data

# Auth — the server refuses to start in production if JWT_SECRET is unset.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# Used once, to create the first admin account. Change before deploying.
ADMIN_EMAIL=admin@vertexa.io
ADMIN_PASSWORD=ChangeMe123!

# SMTP (optional — if left blank, emails are logged to the server console instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CybernaNet
SMTP_FROM_EMAIL=hello@cybernanet.com
